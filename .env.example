# Generate a unique secret of at least 32 characters, e.g. with `openssl rand -base64 32`.
NUXT_APP_SECRET=Generate a unique secret of at least 32 characters
NUXT_BETTER_AUTH_SECRET=Generate a unique secret of at least 32 characters

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Local SQLite. Use a libSQL/Turso URL and DATABASE_AUTH_TOKEN for remote environments.
DATABASE_URL=file:.data/sqlite.db
